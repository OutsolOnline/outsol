# Server only. Never use a NEXT_PUBLIC_ prefix for provider credentials.
RPC_URL=https://your-solana-mainnet-rpc-provider.example
# Optional server-only redundant submission: up to two additional HTTPS mainnet RPCs.
# The exact same signed packet is sent to verified transports. No added tip or platform fee.
# RPC_RACE_URLS=["https://second-solana-mainnet-rpc.example"]
# Required for private production access. Generate independently; never use NEXT_PUBLIC_.
# scrypt$32768$8$1$<16-byte base64url salt>$<32-byte base64url hash>
APP_ACCESS_PASSWORD_HASH=
# 32 random bytes encoded as base64url (43 characters). Rotating either value logs everyone out.
APP_ACCESS_SESSION_SECRET=
# Optional exact browser origin override. Defaults to PUBLIC_APP_URL when set.
APP_ORIGIN=https://your-service.up.railway.app
# Optional Railway volume fallback for public images and token metadata.
ASSET_STORAGE_DIR=/data/vanity-assets
PUBLIC_APP_URL=https://your-service.up.railway.app
ASSET_STORAGE_QUOTA_MB=512
# Optional, server only: Pinata JWT with public file upload permissions.
# Without an upload provider, supply an existing public metadata URI in the app.
PINATA_JWT=
# Optional custom metadata upload backend returning metadataUri + metadata.
IPFS_API_URL=
# Optional connected X account. All five values are server-only runtime settings.
# Use a confidential Web App in the X Developer Console; never paste credentials in chat.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=https://outsol.online/api/x/callback
# One persistent, randomly generated 32-byte key encoded in standard base64.
# Preserve it across deploys. This key is unrelated to browser wallet encryption.
X_TOKEN_ENCRYPTION_KEY=
# Private sibling of ASSET_STORAGE_DIR on the existing Railway /data volume.
X_STORAGE_DIR=/data/vanity-x
# Optional, server only: higher Jupiter market-routing request allowance.
# Keyless routing is supported subject to the provider's availability/rate limits.
# OutSol requests zero integrator fees; this is never a NEXT_PUBLIC value.
JUPITER_API_KEY=
